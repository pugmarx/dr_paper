# ==============================================================================
# Dr. Paper Environment Variables
# ==============================================================================

# LLM Provider Configuration
# Choose: 'gemini' (recommended) or 'groq'
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Groq API Key (Optional fallback, get key at: https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_SCHEMA=dr_paper